# --- AWS CONFIG ---
AWS_REGION=sa-east-1
AWS_S3_BUCKET=tjaem-central-arquivos-prod
AWS_RDS_ENDPOINT=REPLACE_AFTER_TERRAFORM_APPLY

# --- STITCH CONFIG ---
STITCH_API_KEY=your_stitch_key_here
STITCH_DESTINATION=bigquery

# --- n8n CONFIG ---
N8N_HOST=https://n8n.tjaembrasil.com.br
N8N_WEBHOOK_SECRET=generate_secure_random_string_here

# --- APP & SECURITY ---
APP_ENV=production
ENCRYPTION_KEY=generate_32_char_key_here
ALLOWED_ORIGINS=https://tjaembrasil.com.br,https://app.tjaembrasil.com.br

# --- INTEGRATIONS ---
CAMEB_API_URL=https://api.cameb.org.br/v1
EAD_LMS_URL=https://ead.tjaembrasil.com.br
