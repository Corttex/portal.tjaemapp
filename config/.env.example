# TJAEM Environment Variables Example
# Copy this file to .env and fill in the values

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=tjaem-central-arquivos-prod

# Stitch Data Configuration
STITCH_CLIENT_ID=your_client_id
STITCH_API_KEY=your_api_key

# n8n Configuration
N8N_HOST=https://your-n8n-instance.com
N8N_WEBHOOK_SECRET=your_webhook_secret
N8N_ENCRYPTION_KEY=your_encryption_key

# Database (n8n)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your_rds_host
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=your_db_user
DB_POSTGRESDB_PASSWORD=your_db_password

# Security
ENCRYPTION_KEY=your_32_char_encryption_key
LGPD_AUDIT_LOG_PATH=production_artifacts/access_logs/

# Database (App)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tjaem_db
DB_USER=tjaem_user
DB_PASSWORD=your_password

# OpenRouter API (AI Lab)
OPENROUTER_API_KEY=your_openrouter_api_key
