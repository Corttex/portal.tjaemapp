# TJAEM Environment Variables Example
# Copy this file to .env and fill in the values

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=tjaem-central-arquivos-prod

# Stitch Data Configuration
STITCH_CLIENT_ID=your_client_id
STITCH_API_KEY=your_api_key

# n8n Configuration
N8N_HOST=https://your-n8n-instance.com
N8N_WEBHOOK_SECRET=your_webhook_secret

# Security
ENCRYPTION_KEY=your_32_char_encryption_key
LGPD_AUDIT_LOG_PATH=production_artifacts/access_logs/

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tjaem_db
DB_USER=tjaem_user
DB_PASSWORD=your_password
